# Hostly configuration. Copy to `.env` (git-ignored) and adjust.
# Real environment variables take precedence over this file.

# --- Desktop app -------------------------------------------------------------
# The sync server the app uses by default, built into the app when you run
# `npm run tauri dev` or `npm run tauri build`. You can still change it in the
# app's Settings (cog icon). For your hosted API that's https://<HOSTLY_DOMAIN>;
# for a local server, the address in HOSTLY_BIND.
HOSTLY_SERVER_URL=http://127.0.0.1:8080

# --- Sync server ---------------------------------------------------------------
# DATABASE_URL and HOSTLY_BIND are required; the server won't start without them.
# `cargo run -p hostly-server` reads them from this file. A container has no
# .env, so compose must pass DATABASE_URL to it (DATABASE_URL: ${DATABASE_URL});
# HOSTLY_BIND comes from the Dockerfile unless compose passes it as well.

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For a hosted database (Neon, RDS, Supabase, ...), append ?sslmode=require
# Inside a container, localhost is the container itself. To reach PostgreSQL on
# the host machine, use host.docker.internal as HOST (on Linux, the compose
# service also needs extra_hosts: ["host.docker.internal:host-gateway"]).
DATABASE_URL=postgres://hostly:change-me@localhost:5432/hostly_development

# Address the server listens on, as IP:PORT. 127.0.0.1 only accepts this
# machine; inside a container use 0.0.0.0, or nothing outside it can connect.
# The server speaks plain HTTP: put a TLS reverse proxy in front on a public host.
HOSTLY_BIND=127.0.0.1:8080

# Log filter (tracing EnvFilter syntax). Also used by docker compose.
RUST_LOG=hostly_server=info,tower_http=info

# Optional: a separate database the server's integration tests may freely write to.
# When unset, `cargo test -p hostly-server` skips the database tests.
TEST_DATABASE_URL=postgres://hostly:change-me@localhost:5432/hostly_test

# --- Sync server via `docker compose up -d` -----------------------------------
# All optional for local use. On a public server, set a strong POSTGRES_PASSWORD
# (URL-safe characters) and your domain, then: docker compose --profile https up -d
# The POSTGRES_* settings are for the bundled database only; with PostgreSQL on
# the host machine, DATABASE_URL above is what counts.
# POSTGRES_USER=hostly
# POSTGRES_PASSWORD=hostly
# POSTGRES_DB=hostly
# Where the API is published on the machine running compose.
# HOSTLY_PUBLISH=127.0.0.1:8080
# Domain for automatic HTTPS (the `https` profile). DNS must point at this machine.
# HOSTLY_DOMAIN=
